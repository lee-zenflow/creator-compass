# Server-only secrets. Copy to .env.local and replace every placeholder.
DATABASE_URL=postgresql://creator_compass:change-me@localhost:5432/creator_compass
POSTGRES_PASSWORD=replace-with-local-or-production-password
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
EXPECTED_MIGRATION_COUNT=19
WORKER_HEARTBEAT_MAX_AGE_MS=45000
# Comma-separated reverse-proxy IPs/CIDRs; leave empty when running directly.
AUTH_TRUSTED_PROXIES=
# Only enable when the app is behind a trusted reverse proxy that overwrites client IP headers.
RATE_LIMIT_TRUST_PROXY=0

# Never set AI_ADAPTER=test in production. It is only for isolated E2E environments.
AI_ADAPTER=deepseek
# Optional path for the local AES master key. The file is created automatically and must be backed up separately.
CREATOR_COMPASS_MASTER_KEY_PATH=./data/secrets/master.key
# HMAC key for privacy-safe AI/retrieval fingerprints; use a separate random secret in production.
AI_LOG_HMAC_KEY=replace-with-a-separate-high-entropy-random-key

# Private uploads never leave this machine. Keep this directory outside the public web root.
LOCAL_STORAGE_PATH=./data/private
# Encrypted automatic snapshots (latest seven only).
LOCAL_SNAPSHOT_PATH=./data/snapshots
# Optional directory containing pg_dump and psql. Leave empty when they are already on PATH.
POSTGRES_BIN_PATH=
# Local-only BGE embedding service. The product falls back visibly when unavailable.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8765

# Comma-separated allowlist. Seeding never creates fake admin users.
ADMIN_EMAILS=
